IDR_MAINFRAME           ICON                    "res\\xlFlexDemo.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

#define _STR_(N)    #N
#define STR(N)     _STR_(N)
#define VERSIONTEXT xlFlexDemo Version

IDD_ABOUTBOX DIALOGEX 0, 0, 250, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About xlFlexDemo"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           STR(VERSIONTEXT TOOLVERSION),IDC_STATIC,40,10,160,8,SS_NOPREFIX
    LTEXT           STR(COPYRIGHT),IDC_STATIC,40,25,160,8
    DEFPUSHBUTTON   "OK",IDOK,200,6,50,16,WS_GROUP
END

IDD_XLFLEXDEMO_DIALOG DIALOGEX 0, 0, 472, 303
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "xlFlexDemo"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Exit",IDOK,414,280,50,16
    PUSHBUTTON      "About",ID_ABOUT,352,280,50,16
    LISTBOX         IDC_DEVICE,14,18,102,31,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Activate",IDC_ACTIVATE,406,15,57,14,WS_DISABLED
    CONTROL         "",IDC_MSGLIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,7,79,457,195
    PUSHBUTTON      "&Clear Trace",IDC_CLEAR,414,62,50,14
    GROUPBOX        "Hardware",IDC_STATIC,7,7,114,48
    EDITTEXT        IDC_COLDID,185,33,32,12,ES_AUTOHSCROLL,WS_EX_RIGHT
    LTEXT           "SlotID-ColdCC:",IDC_STATIC,135,36,49,8
    GROUPBOX        "Startup/Sync Frame",IDC_STATIC,127,7,158,48
    PUSHBUTTON      "&Add TxFrame",IDC_ADDTXFRAME,406,31,58,14
    PUSHBUTTON      "&Break Trace",IDC_SHOW,308,62,50,14
    LTEXT           "SlotID-E-Ray:",IDC_STATIC,135,22,45,8
    EDITTEXT        IDC_ERAYID,185,20,32,12,ES_AUTOHSCROLL,WS_EX_RIGHT
    CONTROL         "use Cold CC",IDC_COLDCC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,226,34,52,10
    CONTROL         "use E-Ray",IDC_ERAY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,226,19,53,13
    CONTROL         "Spy Mode",IDC_SPY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,298,20,47,10
    GROUPBOX        "Spy Mode",IDC_STATIC,289,7,59,48
    PUSHBUTTON      "&Copy Trace",IDC_BTN_COPY,361,62,50,14
END

IDD_TXFRAME DIALOGEX 0, 0, 259, 98
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add TxFrame"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "&Cancel",IDCANCEL,202,77,50,14
    EDITTEXT        IDC_ID,148,7,35,12,ES_AUTOHSCROLL,WS_EX_RIGHT
    COMBOBOX        IDC_REPETITION,147,23,36,70,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_OFFSET,147,40,35,12,ES_AUTOHSCROLL,WS_EX_RIGHT
    LTEXT           "SlotID:",IDC_STATIC,109,9,23,8
    LTEXT           "Offset:",IDC_STATIC,109,42,24,8
    LTEXT           "Repetition:",IDC_STATIC,109,26,36,8
    PUSHBUTTON      "&Add",IDC_ADDTXFRAME,202,7,50,14
    COMBOBOX        IDC_CHANNEL,40,7,52,70,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Channel:",IDC_STATIC,7,7,31,10
    CONTROL         "TxAkn",IDC_TXAKN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,41,55,36,10
    CONTROL         "Payload Inc.",IDC_PAYLOADINC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,41,42,56,10
    EDITTEXT        IDC_DATA,85,77,97,14,ES_AUTOHSCROLL,WS_EX_RIGHT
    LTEXT           "Data (Hex):",IDC_STATIC,43,79,41,12
    COMBOBOX        IDC_TXMODE,40,23,52,70,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "TxMode:",IDC_STATIC,7,26,29,8
    LTEXT           "Channel:",IDC_STATIC,7,7,31,14
    PUSHBUTTON      "Add 130 frames (Works with Advanced Library Only)",IDC_BTN_ADD_128FRAMES,202,26,50,47,BS_MULTILINE
END


