#define _STR_(N)    #N
#define STR(N)     _STR_(N)
#define VERSIONTEXT xlMOSTView Version 

IDD_ABOUTBOX DIALOGEX 0, 0, 250, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Info über xlMOSTView"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
